{
  "service_type": "api-gateway",
  "description": "API Gateway remediation actions",
  "namespace_patterns": ["AWS/ApiGateway"],
  "resource_keys": {
    "rest_api_id": "ApiId",
    "stage_name": "Stage"
  },
  "actions": {
    "apigw-deployment-rollback": {
      "method": "rollback_apigw_deployment",
      "description": "Revert API Gateway stage to previous deployment",
      "params_from_context": ["rest_api_id", "stage_name"]
    },
    "apigw-throttle-increase": {
      "method": "update_apigw_throttle",
      "description": "Increase API Gateway stage throttle limits",
      "params_from_context": ["rest_api_id", "stage_name"]
    }
  }
}
