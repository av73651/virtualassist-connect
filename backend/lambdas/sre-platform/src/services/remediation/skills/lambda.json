{
  "service_type": "lambda",
  "description": "AWS Lambda remediation actions",
  "namespace_patterns": ["AWS/Lambda", "Custom/Lambda"],
  "resource_keys": {
    "function_name": "FunctionName"
  },
  "actions": {
    "lambda-version-rollback": {
      "method": "rollback_lambda_version",
      "description": "Revert Lambda alias to previous published version",
      "params_from_context": ["function_name"]
    },
    "lambda-memory-increase": {
      "method": "increase_lambda_memory",
      "description": "Increase Lambda memory by one tier",
      "params_from_context": ["function_name"]
    },
    "increase-concurrency": {
      "method": "increase_concurrency",
      "description": "Double reserved concurrency",
      "params_from_context": ["function_name"]
    }
  }
}
